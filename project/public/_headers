/*
 * Cloudflare Pages — _headers file
 *
 * Applied to all responses from the Pages deployment.
 * Rules are matched top-to-bottom; more specific paths override broader ones.
 *
 * Docs: https://developers.cloudflare.com/pages/configuration/headers/
 */

# ── Global security headers (all routes) ──────────────────────────────────────
/*
  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Block clickjacking — allow only same origin to frame this site
  X-Frame-Options: SAMEORIGIN

  # Control referrer information sent to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser features — tighten as needed
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Force HTTPS for 1 year (HSTS). includeSubDomains if you use subdomains.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  # Sources allowed:
  #   'self'                  — same origin (alaman.site)
  #   wa.me / api.whatsapp.com — WhatsApp links opened in new tab (navigation only)
  #   fonts are self-hosted  — no fonts.googleapis.com needed
  #   No inline scripts or styles — all JS/CSS is in hashed bundles
  #   Images: 'self' + data: (for tiny base64 blurs if ever added)
  #   connect-src: 'self' only — no analytics, no external API calls
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://images.pexels.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# ── Hashed JS/CSS bundles — immutable, 1 year ─────────────────────────────────
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# ── Optimised images — long cache ─────────────────────────────────────────────
/assets/images-opt/*
  Cache-Control: public, max-age=31536000, immutable

# ── Original images and logo — long cache ─────────────────────────────────────
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts — immutable (content-hashed filenames in /fonts/) ───────────────────
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Favicon & web manifest — medium cache ─────────────────────────────────────
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32x32.png
  Cache-Control: public, max-age=604800
/favicon-16x16.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192x192.png
  Cache-Control: public, max-age=604800
/icon-512x512.png
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400

# ── HTML pages — short cache, always revalidate ───────────────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ── robots.txt & sitemap — short cache ───────────────────────────────────────
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
